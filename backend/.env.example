# Copy to backend/.env and add a Gemini API key from Google AI Studio.
GEMINI_API_KEY=replace-with-your-own-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1

# Stable alternative if you want to try a different model:
# GEMINI_MODEL=gemini-3.6-flash

# Backend application settings
NEXUS_APP_NAME=NEXUS API
NEXUS_APP_VERSION=0.1.0
NEXUS_API_PREFIX=/api
